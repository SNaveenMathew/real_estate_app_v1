# Copy this file to .env and adjust values as needed
# Most defaults work out of the box with Ollama running locally

# ── Ollama ────────────────────────────────────────────────────────────────────
# URL where Ollama is running
OLLAMA_BASE_URL=http://localhost:11434

# Chat model — must be pulled first: ollama pull llama3.1:8b
# Good alternatives: llama3.2:3b (faster/smaller), mistral:7b, qwen2.5:7b
OLLAMA_MODEL=llama3.1:8b

# Embedding model — must be pulled first: ollama pull nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── App ───────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Map default view (center of the US) ──────────────────────────────────────
MAP_DEFAULT_LAT=37.0902
MAP_DEFAULT_LON=-95.7129
MAP_DEFAULT_ZOOM=5
