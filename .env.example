# Copy this file to .env and adjust values as needed
# Defaults assume `llama-server` (llama.cpp) running locally. Ollama is
# supported as an alternative — see README for switching instructions.

# ── llama-server (llama.cpp) ─────────────────────────────────────────────────
# Base URL for the llama-server HTTP API (as configured in `config.py`)
LLAMA_SERVER_BASE_URL=http://127.0.0.1:8080/v1

# Model identifier for llama-server (HF repo:tag or local path)
# Example: DuoNeural/Gemma-4-26B-A4B-it-GGUF:Q3_K_M
LLAMA_SERVER_MODEL=DuoNeural/Gemma-4-26B-A4B-it-GGUF:Q3_K_M

# ── LLM generation limits (optional tuning) ─────────────────────────────────
# Defensive bounds so a stalled/looping local model can't run one call out to
# the server's full context window. Defaults are in config.py; override here
# only if you've changed hardware/model and need different headroom.
# AGENT_MAX_TOKENS=2048
# CODE_AGENT_MAX_TOKENS=700
# LLM_REQUEST_TIMEOUT=120

# ── Ollama (optional) ───────────────────────────────────────────────────────
# If you prefer Ollama, set these and run `ollama serve` instead of llama-server
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Embedding model (Ollama): ollama pull nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── App ───────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Map default view (center of the US) ──────────────────────────────────────
MAP_DEFAULT_LAT=37.0902
MAP_DEFAULT_LON=-95.7129
MAP_DEFAULT_ZOOM=5

# ── Phoenix / General Chat observability ───────────────────────────────────
# Start local Phoenix with: python -m phoenix.server.main serve
PHOENIX_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
PHOENIX_PROTOCOL=http/protobuf
PHOENIX_UI_URL=http://127.0.0.1:6006
PHOENIX_PROJECT_NAME=real-estate-general-chat

# --- Data page: optional catalog model (drafts descriptions/synonyms only; never decides joins) ---
# Leave empty to reuse the chat llama-server. A separate small instance keeps drafts from queueing behind chat.
# CATALOG_DRAFT_BASE_URL=http://127.0.0.1:8081/v1
# CATALOG_DRAFT_MODEL=
# CATALOG_LLM_ENABLED=true
# CATALOG_LLM_JUDGE_ENABLED=false
# ONBOARDING_MAX_UPLOAD_MB=250

# --- Commute times: free/open services only (see README "Commute times") ---
# WORK_ADDRESS=500 Grant St, Pittsburgh, PA 15219   # optional; the Commute tab can save it instead
# COMMUTE_MODES=drive,bike,walk                     # 'transit' turns on automatically when OTP_BASE_URL is set
# OSRM_DRIVE_URL=https://router.project-osrm.org    # public demo server; self-host OSRM to keep coordinates private
# OSRM_BIKE_URL=https://routing.openstreetmap.de/routed-bike
# OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot
# OSRM_MIN_INTERVAL_S=1.0                           # politeness delay for public servers (use 0 for your own)
# COMMUTE_DRIVE_FACTOR=1.0                          # e.g. 1.3 approximates rush hour; 1.0 = free-flow
# OTP_BASE_URL=http://localhost:8080                # optional self-hosted OpenTripPlanner (enables transit)
# NOMINATIM_EMAIL=you@example.com                   # optional contact for Nominatim's usage policy
